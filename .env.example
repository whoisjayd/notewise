# Example yt-study runtime configuration
#
# This project reads configuration from:
#   ~/.yt-study/config.env
#
# The repository root .env file is not read automatically by the application.
# Copy the keys you need into ~/.yt-study/config.env or export them from your shell.

DEFAULT_MODEL=gemini/gemini-2.0-flash
OUTPUT_DIR=./output
MAX_CONCURRENT_VIDEOS=5
YOUTUBE_REQUESTS_PER_MINUTE=10
TEMPERATURE=0.7
# MAX_TOKENS=2000

# Optional YouTube auth settings (for private/age-gated content)
YOUTUBE_USE_OAUTH=false
YOUTUBE_SAVE_OAUTH_TOKEN=false
# YOUTUBE_OAUTH_TOKEN_FILE=~/.yt-study/youtube_token.json
YOUTUBE_AUTO_REFRESH_OAUTH_TOKEN=true

# Provider API keys
# Configure the key that matches your selected model/provider family.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Notes
# - The current config loader supports the keys above.
# - default_languages, chunk_size, chunk_overlap, and
#   chapter_generation_min_duration are code defaults today, not config.env keys.
