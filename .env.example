# Example notewise runtime configuration
#
# This project reads configuration from:
#   ~/.notewise/config.env
#
# The repository root .env file is not read automatically by the application.
# Copy the keys you need into ~/.notewise/config.env or export them from your shell.

DEFAULT_MODEL=gemini/gemini-2.5-flash
# Allow models missing from the bundled supported-model catalog (e.g. OpenRouter stealth endpoints).
# ALLOW_UNLISTED_MODELS=false
OUTPUT_DIR=./output
MAX_CONCURRENT_VIDEOS=5
YOUTUBE_REQUESTS_PER_MINUTE=10
TEMPERATURE=0.7
# MAX_TOKENS=2000

# Provider API keys
# Configure the key that matches your selected model/provider family.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# AZURE_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# VERCEL_AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
# TOGETHERAI_API_KEY=your_together_ai_api_key_here
# FIREWORKS_AI_API_KEY=your_fireworks_ai_api_key_here
# PERPLEXITYAI_API_KEY=your_perplexity_api_key_here
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# REPLICATE_API_KEY=your_replicate_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# DEEPINFRA_API_KEY=your_deepinfra_api_key_here
# SAMBANOVA_API_KEY=your_sambanova_api_key_here
# CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# AI21_API_KEY=your_ai21_api_key_here
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DATABRICKS_API_KEY=your_databricks_api_key_here
# DATABRICKS_API_BASE=https://your-workspace.cloud.databricks.com/serving-endpoints
# NOVITA_API_KEY=your_novita_api_key_here
# NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
# WATSONX_API_KEY=your_watsonx_api_key_here
# VOYAGE_API_KEY=your_voyage_api_key_here
# JINA_API_KEY=your_jina_api_key_here

# OAuth/device-flow providers (ChatGPT subscription and GitHub Copilot)
# do not use static API keys. LiteLLM starts device authentication on first use
# and stores tokens locally. These optional paths override LiteLLM defaults.
# CHATGPT_TOKEN_DIR=~/.notewise/oauth/chatgpt
# GITHUB_COPILOT_TOKEN_DIR=~/.notewise/oauth/github_copilot

# Ambient credential providers such as Amazon Bedrock use the normal SDK env vars.
# AWS_PROFILE=default
# AWS_REGION_NAME=us-east-1

# Notes
# - The current config loader supports the keys above.
# - default_languages, chunk_size, and chunk_overlap are code defaults today,
#   not config.env keys.
