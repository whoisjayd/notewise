            "pages": [
              "concepts/architecture",
              "concepts/pipeline",
              "concepts/providers"
            ]
          },
          {
            "group": "Guides",
            "icon": "compass",
            "pages": [
              "guides/single-video",
              "guides/playlists-and-batch",
