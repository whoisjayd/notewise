{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "yt-study",
  "description": "Convert YouTube videos and playlists into AI-powered study notes from your terminal.",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#1d4ed8"
