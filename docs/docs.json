{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "NoteWise",
  "description": "Source-backed documentation for the NoteWise YouTube-to-notes CLI.",
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "https://docs.notewise.click"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#2563EB",
    "dark": "#93C5FD"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "grid"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "NoteWise Docs",
      "og:image": "https://docs.notewise.click/og-image.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:card": "summary_large_image",
      "twitter:site": "@whynotjaydeep",
      "twitter:creator": "@whynotjaydeep",
      "twitter:image": "https://docs.notewise.click/og-image.png",
      "theme-color": "#0EA5E9"
    }
  },
  "search": {
    "prompt": "Search NoteWise docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "tokyo-night"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/whoisjayd/notewise"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/notewise/"
      },
      {
        "label": "Issues",
        "href": "https://github.com/whoisjayd/notewise/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/docs/start/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/whoisjayd/notewise",
      "x": "https://x.com/whynotjaydeep"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "claude",
      "chatgpt"
    ],
    "display": "header"
  },
  "redirects": [
    {
      "source": "/yt-study/:slug*",
      "destination": "/docs/:slug*",
      "permanent": true
    },
    {
      "source": "/yt_study/:slug*",
      "destination": "/docs/:slug*",
      "permanent": true
