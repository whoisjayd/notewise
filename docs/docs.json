{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "NoteWise",
  "description": "Install and use NoteWise, the Python CLI that converts YouTube videos and playlists into structured Markdown study notes with LLMs.",
  "logo": {
    "light": "/logo.png",
    "dark": "/logo.png",
    "href": "https://docs.notewise.click"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#1D4ED8",
    "light": "#1D4ED8",
    "dark": "#93C5FD"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "grid"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "description": "Install, configure, and use NoteWise to convert YouTube videos, playlists, and transcripts into structured Markdown study notes with LLM providers.",
      "keywords": "notewise, youtube to notes, youtube notes, youtube transcript, markdown study notes, ai study notes, llm cli, python cli, study guide generator, playlist notes, transcript notes",
      "author": "Jaydeep Solanki",
      "robots": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
      "googlebot": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
      "bingbot": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
      "language": "en",
      "application-name": "NoteWise",
      "apple-mobile-web-app-title": "NoteWise Docs",
      "msapplication-TileColor": "#1D4ED8",
      "color-scheme": "light dark",
      "format-detection": "telephone=no",
      "referrer": "origin-when-cross-origin",
      "rating": "general",
      "distribution": "global",
      "coverage": "Worldwide",
      "category": "Developer Tools",
      "copyright": "Jaydeep Solanki",
      "og:type": "website",
      "og:site_name": "NoteWise Docs",
      "og:locale": "en_US",
      "og:image": "https://docs.notewise.click/og-image.png",
      "og:image:secure_url": "https://docs.notewise.click/og-image.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:image:alt": "NoteWise documentation preview for the YouTube to Markdown study notes CLI",
      "twitter:card": "summary_large_image",
      "twitter:site": "@whynotjaydeep",
      "twitter:creator": "@whynotjaydeep",
      "twitter:domain": "docs.notewise.click",
      "twitter:image": "https://docs.notewise.click/og-image.png",
      "twitter:image:alt": "NoteWise documentation preview for the YouTube to Markdown study notes CLI",
      "twitter:image:width": "1200",
      "twitter:image:height": "630",
      "theme-color": "#0B1118"
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/og-image.png",
    "fonts": {
      "family": "Space Grotesk"
    }
  },
  "search": {
    "prompt": "Search NoteWise docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "tokyo-night"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/whoisjayd/notewise"
      },
      {
        "label": "Website",
        "href": "https://notewise.click"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/notewise/"
      },
      {
        "label": "Issues",
        "href": "https://github.com/whoisjayd/notewise/issues"
