      {
        "label": "GitHub",
        "href": "https://github.com/whoisjayd/yt-study"
      },
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/yt-study/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/getting-started/quickstart"
    }
  },
  "footer": {
