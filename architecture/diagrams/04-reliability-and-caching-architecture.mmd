flowchart TB
    Request["Incoming video processing request"]
    CacheLookup{"Cached result exists\nwith all requested artifacts?"}
    Skip["Skip processing, reuse cached artifacts"]
    Fetch["Fetch metadata and transcript"]

    subgraph NetworkResilience["Network Resilience"]
        RetryFetch["Retry with exponential backoff and jitter\n(transient HTTP/network failures)"]
    end

    subgraph GenerationResilience["Generation Resilience"]
        RetryGen["Retry generation calls\n(provider-side transient failures)"]
        PartialFailure["Partial-Failure Handling\n(one failing chapter does not discard completed siblings)"]
        ResumeCache["Chapter Resume Cache\n(persists completed chapters across reruns)"]
    end

    subgraph OutputResilience["Output Resilience"]
        RenderAttempt{"Requested format\nrenders successfully?"}
        Degrade["Graceful Degradation\n(fall back to Markdown on renderer failure)"]
        WriteFinal["Write final artifact(s) to disk"]
    end

    Request --> CacheLookup
    CacheLookup -- "Yes" --> Skip
    CacheLookup -- "No" --> Fetch
    Fetch --> RetryFetch
    RetryFetch --> GenerationResilience
    RetryGen --> PartialFailure
    PartialFailure -- "some chapters failed" --> ResumeCache
    ResumeCache -. "next run skips completed chapters" .-> CacheLookup
    PartialFailure -- "all chapters completed" --> RenderAttempt
    RenderAttempt -- "Yes" --> WriteFinal
    RenderAttempt -- "No" --> Degrade --> WriteFinal
    WriteFinal --> PersistCache["Persist run stats and cache entry"]
