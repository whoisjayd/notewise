flowchart LR
    classDef actor fill:#FEF3C7,stroke:#D97706,color:#78350F,stroke-width:2px
    classDef component fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A,stroke-width:2px
    classDef store fill:#DCFCE7,stroke:#16A34A,color:#14532D,stroke-width:2px
    classDef external fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:2px
    classDef title fill:#F3F4F6,stroke:#6B7280,color:#111827,stroke-width:1px,stroke-dasharray: 4 3

    TITLE(["NoteWise Local-First Architecture and Data Boundaries<br/>What stays on the machine vs. what leaves it"])
    class TITLE title

    USER["User"]
    class USER actor

    subgraph MACHINE["User's Machine, everything here stays local"]
        CLIAPP["NoteWise Application"]
        class CLIAPP component

        CACHEDB[("Cache Database<br/>video metadata, transcripts, run stats")]
        CONFIGDB[("Config Database<br/>settings, API keys, saved endpoints")]
        TOKENS[("OAuth / Subscription Tokens")]
        LOGS[("Session Logs")]
        OUTPUTS[("Study Documents,<br/>Quizzes, Transcript Exports")]
        class CACHEDB,CONFIGDB,TOKENS,LOGS,OUTPUTS store
    end

    NOTELEMETRY["No telemetry, analytics,<br/>or cloud backend of any kind"]
    class NOTELEMETRY component

    YOUTUBE(("YouTube"))
    PROVIDER(("Chosen AI Provider"))
    class YOUTUBE,PROVIDER external

    TITLE -.-> USER --> CLIAPP

    CLIAPP --> CACHEDB
    CLIAPP --> CONFIGDB
    CLIAPP --> TOKENS
    CLIAPP --> LOGS
    CLIAPP --> OUTPUTS
    CLIAPP -.-> NOTELEMETRY

    CLIAPP -- "read-only content request" --> YOUTUBE
    CLIAPP -- "transcript + prompt" --> PROVIDER
